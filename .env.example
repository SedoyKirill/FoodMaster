# ---------------------------------------------------------------------------
# Ration / FoodMaster — local configuration.
#
#   copy .env.example .env      (PowerShell / cmd)
#   cp   .env.example .env      (bash)
#
# The defaults below work as-is for `docker compose up -d`. This file is the
# only place secrets and machine-specific settings live; .env is git-ignored.
# Save it as UTF-8 — it contains Russian comments.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_ENV=prod
# Wall-clock timezone. Containers run in UTC; without this the 03:00 store
# parse would record prices under the previous calendar date.
APP_TIMEZONE=Europe/Moscow
LOG_FORMAT=json
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# Credentials for the bundled `db` service. The app itself has no auth (it
# never leaves the local network), but Postgres still needs a role.
POSTGRES_USER=ration
POSTGRES_PASSWORD=ration
POSTGRES_DB=ration
# Published on loopback only, so scripts/dev.ps1, pytest and a DB client on the
# host can reach it. Change if something else already owns 5432.
DB_PORT=5432

# Async SQLAlchemy URL. Host `db` is the compose service name; docker-compose
# overrides this value for the containers, and scripts/dev.ps1 overrides it
# with `localhost` when the app runs natively on Windows.
DATABASE_URL=postgresql+asyncpg://ration:ration@db:5432/ration

# --- Web exposure ----------------------------------------------------------
# Address the API/UI port is published on:
#   127.0.0.1 — this PC only (default, safest)
#   0.0.0.0   — reachable from phones and other devices on the home network
#
# NOTE: the specification calls this knob WEB_EXPOSE=0|1. Docker Compose has no
# conditional expressions, and the natural attempts fail OPEN (an empty host_ip
# means 0.0.0.0) — the wrong direction for an app with no authentication. So
# the bind address itself is the knob. See docs/setup.ru.md.
# Exposing to the LAN also needs a Windows Defender Firewall inbound rule for
# TCP 8000 and the home Wi-Fi classified as a "Private" network.
WEB_BIND_IP=127.0.0.1
WEB_PORT=8000

# --- LLM -------------------------------------------------------------------
# none   — fully deterministic, button-driven mode (everything works without an LLM)
# ollama — local Ollama container with GPU
# claude — Anthropic API (requires ANTHROPIC_API_KEY)
LLM_PROVIDER=none
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_PORT=11434
OLLAMA_TIMEOUT_S=120
# How long a model stays resident in VRAM between requests.
OLLAMA_KEEP_ALIVE=10m
ANTHROPIC_API_KEY=

# --- Embeddings (M2) -------------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# --- Stores (M3) -----------------------------------------------------------
# Comma-separated list of enabled store adapters.
STORES=5ka,lenta
# Store ids of the nearest shops. Find them in the site's network requests
# after picking an address; see app/store/<store>/README.md (filled in M3).
FIVEKA_STORE_ID=
LENTA_STORE_ID=
STORE_REQUEST_DELAY_S=1.0

# --- Scheduler -------------------------------------------------------------
# Nightly store catalogue parsing (M3).
PARSE_CRON_HOUR=3
PARSE_CRON_MINUTE=0
# Nightly database backup (M1) — deliberately after the parse, so the dump
# contains the night's prices.
BACKUP_CRON_HOUR=4
BACKUP_CRON_MINUTE=30

# --- Backups ---------------------------------------------------------------
# Dumps always land in the `backups` docker volume. BACKUP_DIR names an
# optional SECOND destination, as a path INSIDE the scheduler container.
#
# A NAS SMB share cannot be bind-mounted from Windows with the WSL2 backend:
# mount it inside Docker instead, using the optional override file:
#   docker compose -f docker-compose.yml -f docker-compose.nas.yml up -d
# then set BACKUP_DIR=/mnt/nas-backup and fill in the NAS_* values below.
# Leave BACKUP_DIR empty to keep dumps in the volume only.
BACKUP_DIR=
BACKUP_KEEP=14

# Only used by docker-compose.nas.yml.
NAS_HOST=
NAS_SHARE=
NAS_USER=
NAS_PASSWORD=
