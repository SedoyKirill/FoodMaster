POSTGRES_DB=ration
POSTGRES_USER=ration
POSTGRES_PASSWORD=ration
DATABASE_URL=postgresql://ration:ration@db:5432/ration

LENTA_STORE_CODE=lenta-155
LENTA_STORE_ID=155
LENTA_CITY=Иваново
LENTA_STORE_ADDRESS=Карла Маркса ул., 3
LENTA_RUN_AT=03:00
LENTA_TIMEZONE=Europe/Moscow
# API Ленты ограничивает частоту запросов (HTTP 429): пауза меньше секунды
# приводит к обрыву половины категорий. При 429 темп замедляется сам,
# вплоть до LENTA_MAX_DELAY_SECONDS между страницами.
LENTA_PAGE_DELAY_SECONDS=1.2
LENTA_MAX_DELAY_SECONDS=15.0
LENTA_MAX_PAGES=100
LENTA_PAGE_SIZE=40
# Карточки (состав, КБЖУ) догружаются партиями за ночь; КБЖУ блюд в планах
# считается из этих данных, поэтому лимит поднят.
LENTA_DETAIL_LIMIT=1500
LENTA_API_BASE_URL=https://api.baseomni.ru/v1
# Версия заголовков подтверждена по официальному APK 14.08.2026.
LENTA_APP_VERSION=6.93.0
LENTA_ANDROID_RELEASE=15
LENTA_ANDROID_SDK=35
LENTA_REQUEST_TIMEOUT_SECONDS=30
LENTA_REQUEST_RETRIES=3
LENTA_RUN_ON_START=false

# Пустое значение означает стандартный список продуктовых категорий.
LENTA_CATEGORIES=

# Импорт локальных PDF-книг. OCR работает только для страниц без нормального
# текстового слоя, которые визуально похожи на текст, а не на полноэкранное фото.
RECIPE_OCR_ENABLED=true
RECIPE_OCR_DPI=300
RECIPE_OCR_LANGUAGES=rus+eng
RECIPE_MIN_NATIVE_CHARS=80

# Переимпорт рецептов (TZ-M2R): окна для сессии Haiku и загрузка результатов.
RECIPE_WINDOW_PAGES=4
RECIPE_WINDOW_STEP=3
RECIPE_LLM_SCHEMA_VERSION=1

# Локальное web-приложение: http://localhost:8080
COOKIE_SECURE=false
# Заполнить после создания Telegram-бота через BotFather.
TELEGRAM_BOT_USERNAME=
# Токен бота (секрет!) — хранить только в локальном .env, не коммитить.
TELEGRAM_BOT_TOKEN=
# Публичный адрес веба: бот кладёт его в ссылку входа (TZ-M7 §3.3).
# Для доступа с телефона укажите адрес машины в локальной сети,
# например http://192.168.1.10:8080.
WEB_PUBLIC_URL=http://localhost:8080
